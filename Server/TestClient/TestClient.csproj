<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FlatBufferGenDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Server\Generated\FlatBuffer\'))</FlatBufferGenDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerCore\ServerCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.FlatBuffers" Version="24.3.25" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(FlatBufferGenDir)*.cs">
      <Link>Generated\FlatBuffer\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
