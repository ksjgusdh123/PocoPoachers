    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerCore\ServerCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.FlatBuffers" Version="24.3.25" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Server\PacketGenerator\Generated\*.cs">
      <Link>Generated\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
