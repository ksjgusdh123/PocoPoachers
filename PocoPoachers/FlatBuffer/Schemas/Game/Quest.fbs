// 모든 퀘스트의 진행은 호스트가 확정한다. 개인 상태의 player_id는 소유자, 공유 상태는 0이다.
table G_QuestAccept { quest_id: int; }
// 수락뿐 아니라 접속 시/상태 변경 시에도 보내는 절대값 스냅샷이다.
table H_QuestAccept {
    quest_id: int;
    player_id: int;
    state: int;
    revision: long;
    item_ids: [int];
    item_counts: [int];
}
table G_QuestSubmit {
    quest_id: int;
    item_id: int;
    amount: int;
    request_id: long;
}
// 요청자에게만 보내는 제출 결과. amount는 승인 수량이며 나머지는 로컬에서 환불한다.
table H_QuestSubmit {
    quest_id: int;
    item_id: int;
    amount: int;
    request_id: long;
    player_id: int;
}
table G_QuestComplete { quest_id: int; }
// 완료 상태는 스냅샷으로 동기화하고 이 패킷은 보상 수령자에게만 전송한다.
table H_QuestComplete { quest_id: int; player_id: int; }
