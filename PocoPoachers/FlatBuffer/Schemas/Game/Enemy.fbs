include "Common.fbs";

table H_EnemySpawn
{
    enemy_type_id: int;
    enemy_id: int;
    pos:      Vec3;
    rotation: float;
    hp:       float;
    max_hp:   float;
    weapon_id: int;
    helmet_id: int;
}

table H_EnemyMove
{
    enemy_id: int;
    pos:      Vec3;
    rotation: float;
}

table H_EnemyHit
{
    enemy_id: int;
    hp:       float;
    max_hp:   float;
    damage:   float;
}

table H_EnemyDie
{
    enemy_id: int;
}
