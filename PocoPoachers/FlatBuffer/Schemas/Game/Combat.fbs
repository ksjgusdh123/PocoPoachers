include "Common.fbs";

table G_Shoot
{
    player_id:    int;
    origin:       Vec3;
    direction:    Vec3;
    bullet_speed: float;
    damage:       float;
    max_range:    float;
    sound_range:  float;
    directions:   [Vec3]; // 샷건 등 다발 발사의 펠릿별 방향. 비어 있으면 direction 단발로 처리
    is_headshot:  bool;   // 발사 순간 크로스헤어 기준 헤드샷 판정
}

table H_Shoot
{
    player_id:    int;
    origin:       Vec3;
    direction:    Vec3;
    bullet_speed: float;
    damage:       float;
    max_range:    float;
    directions:   [Vec3]; // 샷건 등 다발 발사의 펠릿별 방향. 비어 있으면 direction 단발로 처리
    is_headshot:  bool;   // 발사 순간 크로스헤어 기준 헤드샷 판정
}

// 호스트가 G_Shoot를 거부했을 때 게스트 로컬 탄약/내구도를 권위 값으로 되돌림
table H_ShootRejected
{
    item_uid:           int;
    current_ammo:       int;
    current_durability: float;
}

// 호스트가 게스트의 G_Shoot로 스폰한 권위 총알이 대상을 처치했을 때, 쏜 게스트에게만 되돌려줘
// 히트마커를 빨간색(헤드샷이면 주황빨강)으로 확인시키는 용도 (게스트 자신의 로컬 총알은 데미지를 적용하지 않아 사망 여부를 모른다)
table H_HitConfirm
{
    is_kill:     bool;
    is_headshot: bool;
}

table G_StatSync
{
    hp:      float;
    max_hp:  float;
    stamina: float;
    battery:  float;
    defense: float;
}

table H_StatSync
{
    player_id: int;
    hp:        float;
    max_hp:    float;
    stamina:   float;
    battery:    float;
    defense:   float;
}

table H_SandbagDestroy
{
    sandbag_id: int;
}

// 구출 진행 알림 — state: 0=시작, 1=취소, 2=완료 (RescueState)
// 구출자 id는 호스트가 송신자로부터 직접 판별하므로 게스트가 실을 수 없다
table G_Rescue
{
    target_id: int;
    state:     byte;
    duration:  float;
}

// 호스트가 구출자·대상 두 명에게만 되돌려주는 구출 진행 정보
table H_Rescue
{
    rescuer_id: int;
    target_id:  int;
    state:      byte;
    duration:   float;
}

// 완전 사망 시 호송 빔 연출 트리거 — 게스트가 보내면 호스트가 전체 게스트에 전파한다.
// 죽은 플레이어 id는 호스트가 송신자로부터 직접 판별하므로 게스트가 실을 필요가 없다.
table G_RescueBeamPlay
{
}

table H_RescueBeamPlay
{
    player_id: int;
}
