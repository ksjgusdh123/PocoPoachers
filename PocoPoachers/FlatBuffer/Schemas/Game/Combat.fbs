include "Common.fbs";

table G_Shoot
{
    player_id:    int;
    origin:       Vec3;
    direction:    Vec3;
    bullet_speed: float;
    damage:       float;
    max_range:    float;
    sound_range:  float;
    directions:   [Vec3]; // 샷건 등 다발 발사의 펠릿별 방향. 비어 있으면 direction 단발로 처리
    is_headshot:  bool;   // 발사 순간 크로스헤어 기준 헤드샷 판정
    bullet_seqs:  [int]; // directions와 같은 순서. 쏜 클라가 발급하며 (player_id, seq)로 유일하다
}

table H_Shoot
{
    player_id:    int;
    origin:       Vec3;
    direction:    Vec3;
    bullet_speed: float;
    damage:       float;
    max_range:    float;
    directions:   [Vec3]; // 샷건 등 다발 발사의 펠릿별 방향. 비어 있으면 direction 단발로 처리
    is_headshot:  bool;   // 발사 순간 크로스헤어 기준 헤드샷 판정
    bullet_seqs:  [int]; // directions와 같은 순서. 쏜 클라가 발급하며 (player_id, seq)로 유일하다
}

// 호스트가 G_Shoot를 거부했을 때 게스트 로컬 탄약/내구도를 권위 값으로 되돌림
table H_ShootRejected
{
    item_uid:           int;
    current_ammo:       int;
    current_durability: float;
}

// 호스트가 게스트의 G_Shoot로 스폰한 권위 총알이 대상을 처치했을 때, 쏜 게스트에게만 되돌려줘
// 히트마커를 빨간색(헤드샷이면 주황빨강)으로 확인시키는 용도 (게스트 자신의 로컬 총알은 데미지를 적용하지 않아 사망 여부를 모른다)
table H_HitConfirm
{
    is_kill:     bool;
    is_headshot: bool;
}

table G_StatSync
{
    hp:      float;
    max_hp:  float;
    stamina: float;
    battery:  float;
    defense: float;
    crit_multiplier: float = 2.0; // 크리티컬(헤드샷) 데미지 배율. 기본값이라 평상시엔 기록되지 않는다
    range_multiplier: float = 1.0; // 탄환 사거리 배율. 기본값이라 평상시엔 기록되지 않는다
}

table H_StatSync
{
    player_id: int;
    hp:        float;
    max_hp:    float;
    stamina:   float;
    battery:    float;
    defense:   float;
    crit_multiplier: float = 2.0; // 크리티컬(헤드샷) 데미지 배율. 기본값이라 평상시엔 기록되지 않는다
    range_multiplier: float = 1.0; // 탄환 사거리 배율. 기본값이라 평상시엔 기록되지 않는다
}

table H_SandbagDestroy
{
    sandbag_id: int;
}

// 구출 진행 알림 — state: 0=시작, 1=취소, 2=완료 (RescueState)
// 구출자 id는 호스트가 송신자로부터 직접 판별하므로 게스트가 실을 수 없다
table G_Rescue
{
    target_id: int;
    state:     byte;
    duration:  float;
}

// 호스트가 구출자·대상 두 명에게만 되돌려주는 구출 진행 정보
table H_Rescue
{
    rescuer_id: int;
    target_id:  int;
    state:      byte;
    duration:   float;
}

// 완전 사망 시 호송 빔 연출 트리거 — 게스트가 보내면 호스트가 전체 게스트에 전파한다.
// 죽은 플레이어 id는 호스트가 송신자로부터 직접 판별하므로 게스트가 실을 필요가 없다.
table G_RescueBeamPlay
{
}

table H_RescueBeamPlay
{
    player_id: int;
}

// 무적 동기화 — 게스트→호스트 단방향이면 충분하다.
// 플레이어 HP는 호스트 권위(H_StatSync)라, 게스트가 알리지 않으면 구르기 무적이 무시된다.
// 반대 방향은 필요 없다: 게스트 탄환은 적과의 충돌을 판정하지 않고 H_BulletHit만 보고 처리한다.
// 게스트 자신의 무적(구르기 등)을 호스트에 알린다 — 호스트가 적 공격을 판정하므로 모르면 그냥 맞는다.
table G_Invincible
{
    value: bool;
}

// 호스트가 판정한 탄환 명중. 게스트 탄환은 적과의 충돌을 스스로 판정하지 않으므로
// 혈흔·탄환 소멸이 전부 이 통보로만 일어난다 — 무적/회피로 관통한 경우엔 아예 오지 않는다.
// 빗나간 탄환은 통보 없이 각자 사거리 끝에서 사라지므로, 명중할 때만 오간다.
table H_BulletHit
{
    shooter_id: int;   // 쏜 플레이어
    seq:        int;   // 그 플레이어가 발급한 탄환 순번
    pos:        Vec3;
    normal:     Vec3;
    is_kill:    bool;  // 히트마커 색 구분용
    is_headshot: bool;
}

// 수류탄 투척 — origin/target만 신는다. 데미지·반경·퓨즈는 skill_id로 player_skill.csv를 찾아
// 수신측이 직접 계산한다(총알 데미지를 게스트 패킷값 대신 gun.Stat에서 읽는 것과 같은 이유).
// 실제 물리 시뮬레이션은 호스트에서만 돈다(EnemyMove와 같은 구조) — 게스트는 요청만 보낸다.
table G_GrenadeThrow
{
    skill_id: int;
    origin:   Vec3;
    target:   Vec3;
}

// 호스트가 권위 수류탄을 스폰했다는 통보. grenade_id는 호스트가 발급하며 이후 H_GrenadeMove/
// H_GrenadeExplode가 이 값으로 어느 수류탄인지 가리킨다. 던진 게스트 본인은 이미 로컬 예측
// 사본이 있으므로 받지 않는다(스킵 전송).
table H_GrenadeThrow
{
    player_id:  int;
    skill_id:   int;
    grenade_id: int;
    origin:     Vec3;
    target:     Vec3;
}

// 호스트가 물리 시뮬레이션 중인 권위 수류탄의 위치를 주기적으로 전파 (H_EnemyMove와 같은 방식)
table H_GrenadeMove
{
    grenade_id: int;
    pos:        Vec3;
}

// 호스트가 판정한 폭발. 피해는 호스트가 이미 적용했으므로 게스트는 이 위치에서 연출만 재생한다.
table H_GrenadeExplode
{
    grenade_id: int;
    pos:        Vec3;
}
