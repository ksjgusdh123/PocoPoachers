include "Common.fbs";

table H_ItemSpawn
{
    uid:      int;
    type_id:  int;
    pos:      Vec3;
    rotation: float;
    item_ids: [int];
    item_count: [int];
    item_uids: [int]; // item_ids와 같은 순서, 무기/방어구 등 인스턴스 식별용 (소모품은 0)
    item_slots: [int]; // item_ids와 같은 순서의 슬롯 인덱스 — 스냅샷 시 호스트와 슬롯 배치를 일치시킴 (없으면 순차 배치)
}

table H_ItemDespawn
{
    uid: int;
}

table G_ItemGain
{
    is_player_gained: bool;
    box_uid:      int;
    item_type_id: int;
    item_uid:     int; // 스택 불가 아이템(무기/방어구)의 인스턴스 uid, 없으면 0
    amount:       int;
    added_slot_index: int;
    removed_slot_index:   int;
}

table H_ItemGainResult
{
    success:            bool;
    box_uid:            int;
    item_type_id:       int;
    item_uid:           int;
    amount:             int;
    player_slot_index:  int = -1;
    box_slot_index:     int = -1;
}

table H_ItemBoxUpdate
{
    box_uid: int;
    item_type_id: int;
    item_uid: int;
    amount: int;
    slot_index: int;
}

table G_ItemExchange
{
    box_uid:            int;
    player_item_id:     int;
    player_item_amount: int;
    player_item_uid:    int; // 박스에 넣는 플레이어 아이템의 인스턴스 uid, 없으면 0
    player_slot_index:  int;
    box_item_id:        int;
    box_item_amount:    int;
    box_item_uid:       int; // 박스에서 꺼내는 아이템의 인스턴스 uid, 없으면 0 (요청 시점 로컬 박스 상태 기준)
    box_slot_index:     int;
}

table H_ItemExchangeResult
{
    success:            bool;
    box_uid:            int;
    player_item_id:     int;
    player_item_amount: int;
    player_item_uid:    int;
    player_slot_index:  int;
    box_item_id:        int;
    box_item_amount:    int;
    box_item_uid:       int;
    box_slot_index:     int;
}

// item_id = 0 이면 해제
table G_Equip
{
    player_id:  int;
    item_id:    int;
    item_uid:   int; // 장착하는 아이템 인스턴스의 uid (없으면 0, 호스트가 신규 발급)
    slot_index: int;
}

table H_Equip
{
    player_id:  int;
    item_id:    int;
    item_uid:   int;
    slot_index: int;
}

table G_ConsumeItem
{
    item_id: int;
    amount: int;
}

table H_ConsumeItemResult
{
    player_id: int;
    item_id:   int;
}

// 장비 내구도 변화 요청 (발사/피격 등) — 호스트가 실제 값을 계산해서 H_Durability로 결과를 알려줌
table G_Durability
{
    item_uid: int;
    item_id:  int;   // 호스트가 해당 uid를 처음 보는 경우 기본 내구도 산정에 사용
    amount:   float; // 변화량 (양수면 회복, 음수면 감소)
}

table H_Durability
{
    item_uid: int;
    current:  float;
    max:      float;
}

// 총 파츠 장착/해제 — part_id=0이면 해제. 게스트가 호스트에게 처리를 요청한다
// current_ammo/max_magazine은 파츠 변경 직후 클라이언트(요청자)의 실제 값을 그대로 신뢰한다
// (탄약은 발사/재장전 때마다 동기화되지 않으므로 호스트가 재계산할 수 없음)
// 다른 플레이어의 화면에는 영향 없는 정보라 게스트로의 브로드캐스트는 하지 않는다
table G_GunPartEquip
{
    gun_uid:      int;
    slot_type:    int;
    part_id:      int;
    current_ammo: int;
    max_magazine: int;
    part_uid:     int; // 파츠 인스턴스 uid (강화 레벨 연결용, 없으면 0)
    part_level:   int; // 게스트가 로컬에서 계산한 파츠 강화 레벨 — 호스트가 partUid 기준으로 저장한다
}

// 무기 해제 시점의 탄약 저장 요청 (게스트→호스트). 마찬가지로 다른 플레이어 화면에는 영향 없어 브로드캐스트 없음
table G_GunAmmoSave
{
    gun_uid:      int;
    current_ammo: int;
    max_magazine: int;
}

// G_Equip 응답 — 호스트가 보관 중인 총기 인스턴스 상태(탄약/파츠)를 장착한 게스트에게 되돌려준다.
// 게스트는 WorldEquipmentManager를 신뢰할 수 없어(자기 세이브 데이터가 들어있음) 스스로 복원할 수 없다.
// 내구도는 기존 H_Durability가 담당하므로 여기 포함하지 않는다.
// 요청한 게스트에게만 보낸다 — 남의 화면에는 영향 없는 정보다.
table H_GunState
{
    gun_uid:      int;
    has_ammo:     bool; // false면 저장된 탄약이 없다는 뜻 — 게스트는 풀장전 기본값을 유지한다
    current_ammo: int;
    max_magazine: int;
    // 파츠 목록 — 슬롯은 GunPartData.slot_type에 있으므로 따로 보내지 않는다
    part_ids:    [int];
    // 강화 레벨을 호스트가 계산해 보낸다 — 게스트 로컬의 강화 상태는 호스트 월드와 무관하다
    part_levels: [int]; // part_ids와 같은 순서
    // 파츠 인스턴스 uid — 게스트가 파츠 해제 시 강화 상태를 잃지 않도록 복원용으로 저장한다
    part_uids:   [int]; // part_ids와 같은 순서
}