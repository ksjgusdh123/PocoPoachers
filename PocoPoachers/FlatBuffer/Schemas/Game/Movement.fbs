include "Common.fbs";

table G_Move
{
    player_id:    int;
    pos:          Vec3;
    rotation:     float;
    move_type:    byte;
    velocity_x:   float;
    velocity_z:   float;
    is_sprinting: bool;
    is_rolling:   bool;
    is_aiming:    bool;
    is_reloading: bool;
    is_down:      bool; // HP 0으로 쓰러진 상태 — 원격 쓰러짐 애니메이션 동기화
}

table H_Move
{
    player_id:    int;
    pos:          Vec3;
    rotation:     float;
    move_type:    byte;
    velocity_x:   float;
    velocity_z:   float;
    is_sprinting: bool;
    is_rolling:   bool;
    is_aiming:    bool;
    is_reloading: bool;
    is_down:      bool; // HP 0으로 쓰러진 상태 — 원격 쓰러짐 애니메이션 동기화
}
