include "Common.fbs";

table NetInfo
{
    player_id: int;
    public_ip: string;
    public_port: ushort;
    private_ip: string;
    private_port: ushort;
}

table C_CreateRoom
{
    my_info: NetInfo;
}

table S_CreateRoom
{
    session_code: string;
    success: bool;
}

table C_JoinRoom
{
    session_code: string;
    my_info: NetInfo;
}

table S_JoinRoom
{
    success: bool;
    host_info: NetInfo;
}

table S_GuestJoined
{
    info: NetInfo;
}

table H_GuestJoined
{
    info: [PlayerInfo];
}

table G_Leave
{
    player_id: int;
}

table H_Leave
{
    player_id: int;
    is_host:   bool;
}

table G_ShelterLevel
{
    level: int;
}

table H_ShelterLevel
{
    level: int;
}

table H_LoadScene
{
    scene_name: string;
    spawn_id: int;
}

table G_SceneReady
{
    player_id: int;
}

// 방 세계 복원용 — 호스트가 저장해둔 게스트의 인벤 한 칸
table GuestInvEntry
{
    slot_index: int;
    item_id:    int;
    amount:     int;
    item_uid:   int; // 무기/방어구 등 인스턴스 uid, 소모품은 0
}

// 방 세계 복원용 — 게스트의 장착 슬롯 한 칸
table GuestEquipEntry
{
    slot_index: int;
    item_id:    int;
    item_uid:   int;
}

// 호스트→게스트(신뢰), 접속 시 방 세계에 저장된 그 게스트의 상태를 복원시킨다.
// 인벤/로드아웃만 담는다 — 총 내구도/파츠/탄약은 게스트가 재장착할 때 H_Durability/H_GunState가 채운다.
table H_GuestRestore
{
    player_id: int;
    inventory: [GuestInvEntry];
    equips:    [GuestEquipEntry];
    quick_slots: [GuestInvEntry]; // 기존 오프셋 유지를 위해 반드시 끝에 추가
}

// 호스트→게스트(신뢰), 팀 이동 전에 동의를 구한다. 게스트는 G_MoveReply로 답한다.
table H_MoveRequest
{
    scene_name: string;
    spawn_id: int;
}

// 게스트→호스트(신뢰), 이동 제안에 대한 응답.
table G_MoveReply
{
    player_id: int;
    accepted: bool;
}

// 호스트→게스트(신뢰), 이동 투표 현황. 게스트도 호스트와 같은 인원 아이콘 열을 그린다.
table H_MoveProgress
{
    member_ids: [int];  // 표시 순서 (0번은 호스트)
    accepted:   [bool]; // 같은 인덱스의 수락 여부
}

// 호스트→게스트(신뢰), 탈출 구역 상태. 판정은 호스트만 하고 게스트는 게이지/결과창만 맞춘다.
table H_EscapeState
{
    active:    bool;   // 구역에 한 명이라도 있는지 (알림 UI 표시 여부)
    duration:  float;  // 필요 시간 (게이지 길이)
    completed: bool;   // 탈출 확정 — 결과창 표시
    inside:    [bool]; // 표시 순서대로 구역 안 여부 (0번은 호스트)
    charging:  bool;   // 전원 집결 — 게이지 충전 중
    member_ids: [int]; // inside와 같은 순서의 플레이어 id — 각자 자기 항목을 찾아 UI 표시 여부를 정한다
    zone_id:    int;   // 탈출 구역이 여러 개일 때 어느 구역의 상태인지
}

// 호스트→게스트(신뢰), 이동이 무산됐음을 알려 대기 UI를 닫게 한다.
table H_MoveCancel
{
    reason: int; // 0=게스트 거절, 1=응답 시간 초과, 2=호스트 취소
}

// 게스트→호스트(신뢰), 접속 직후 자기 닉네임을 보고한다.
// 호스트는 payload의 player_id를 믿지 않고 실제 송신자 id로 키를 잡는다.
table G_Nickname
{
    player_id: int;
    nickname:  string;
}

// 호스트→게스트(신뢰), 방 전체 닉네임 명부. 델타가 아니라 매번 전체를 보낸다 —
// 신규 접속자 초기화와 기존 인원 갱신이 한 패킷으로 끝나고, 몇 번 도착하든 결과가 같다.
table H_Roster
{
    player_ids: [int];
    nicknames:  [string]; // 같은 인덱스끼리 짝
}

// 게스트→호스트(신뢰), 씬 전환 직전에 자기 상태를 올린다. 호스트는 방 세계 세이브에 기록해
// 맵 이동마다 오토세이브가 되게 하고, 게스트 인벤 미러(GuestInventoryTracker)도 이 값으로 맞춘다.
// 게스트 자신의 복원은 이 패킷을 기다리지 않는다 — 로컬 캐리오버(GuestStateCarry)가 담당한다.
table G_GuestSnapshot
{
    player_id:   int;
    inventory:   [GuestInvEntry];
    equips:      [GuestEquipEntry];
    quick_slots: [GuestInvEntry];
}