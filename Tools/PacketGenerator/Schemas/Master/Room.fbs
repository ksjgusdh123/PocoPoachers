table MemberInfo
{
    player_id: int;
    public_ip: string;
    public_port: ushort;
    private_ip: string;
    private_port: ushort;
}

table C_CreateRoom
{
    my_info: MemberInfo;
}

table S_CreateRoom
{
    session_code: string;
    success: bool;
}

table C_JoinRoom
{
    session_code: string;
    my_info: MemberInfo;
}

table S_JoinRoom
{
    success: bool;
    host_info: MemberInfo;
}

table S_GuestJoined
{
    info: MemberInfo;
}