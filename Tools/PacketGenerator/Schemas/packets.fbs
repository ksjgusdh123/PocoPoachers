namespace Packets;

union EPacketType {
  C_LoginReq,
  C_ChatReq,
  C_LogoutReq,
  S_ChatRes,
}

table C_LoginReq {
  name:string (required);
}

table C_ChatReq {
  text:string (required);
}

table C_LogoutReq {}

table S_ChatRes {
  text:string (required);
}

table RootPacket {
  payload: EPacketType;
}

root_type RootPacket;
