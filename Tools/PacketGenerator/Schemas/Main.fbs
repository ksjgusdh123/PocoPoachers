include "Common.fbs";
include "Auth.fbs";
include "Movement.fbs";
include "Inventory.fbs";
include "WorldItem.fbs";

union PacketType
{
    C_LoginReq,
    S_LoginRes,

    C_MoveReq,
    S_MoveNtf,

    C_AddItemReq,
    S_AddItemRes,
    C_RemoveItemReq,
    S_RemoveItemRes,
    S_InventoryNtf,

    S_WorldItemSpawnNtf,
    S_WorldItemDespawnNtf,
    S_SpawnItemBoxNtf,
    C_OpenBox,
    C_GainItemReq,
    S_ChangeItemBox,
    S_SuccessGainItemNtf,
}

table FlatPacket
{
    type: PacketType;
}

root_type FlatPacket;
