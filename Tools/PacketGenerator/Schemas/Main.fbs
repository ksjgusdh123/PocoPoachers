include "Common.fbs";
include "Master/Auth.fbs";
include "Master/Heartbeat.fbs";
include "Master/Room.fbs";
include "Game/Movement.fbs";
include "Game/Combat.fbs";
include "Game/Item.fbs";

union PacketType
{
    // --- [SECTION 1] 중앙 서버 (Lobby / Auth) ---
    C_Login,
    S_LoginResult,
    C_Logout,

    C_Heartbeat,
    S_HeartbeatAck,

    // --- [SECTION 2] P2P 시그널링 (Matching) ---
    C_CreateRoom,
    S_CreateRoom,

    C_JoinRoom,
    S_JoinRoom,

    // --- [SECTION 3] 인게임 동기화 (P2P - UDP) ---
    G_Move,
    H_Move,

    G_Shoot,
    H_Shoot,

    // --- [SECTION 4] 월드 및 아이템 (P2P - Reliable) ---
    H_ItemSpawn,
    H_ItemDespawn,

    G_ItemGain,
    H_ItemGainResult,

    H_ItemBoxUpdate,
    H_InventoryUpdate,

    G_ItemExchange,
    H_ItemExchangeResult,

    G_ConsumeItem,
    H_ConsumeItemResult,
    
    S_PeerJoined,
}

table FlatPacket
{
    type: PacketType;
}

root_type FlatPacket;
